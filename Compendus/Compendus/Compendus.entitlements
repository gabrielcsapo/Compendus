<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array/>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.gabrielcsapo.Compendus.shared</string>
	</array>
	<!--
	CarPlay audio entitlement. Apple-managed: requested via
	https://developer.apple.com/contact/carplay/ and approved 2026-05-28.
	Requires a provisioning profile that includes the CarPlay capability.
	-->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
