{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "app/routes.ts",
    "app/root.tsx",
    "app/routes/**/*.tsx",
    "server.ts",
    "server/index.ts",
    "scripts/*.ts",
    "tests/**/*.ts",
    "app/lib/reader/parser-worker.ts"
  ],
  "project": ["app/**/*.{ts,tsx}", "server/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "ignore": ["app/types/**/*.d.ts", "local/**"],
  "ignoreDependencies": [
    "@tailwindcss/typography",
    "@types/*",
    "puppeteer",
    "tailwindcss",
    "canvas",
    "isbot"
  ],
  "vite": {
    "config": ["vite.config.ts"]
  },
  "vitest": {
    "config": ["vite.config.ts"]
  }
}
