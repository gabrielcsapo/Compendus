{
  "name": "compendus",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "pnpm run build && node --import tsx server.ts",
    "dev": "vite",
    "build": "tsx scripts/build-worker.ts && react-flight-router build && tsx scripts/copy-migrations.ts",
    "build:worker": "tsx scripts/build-worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "oxfmt --check && oxlint",
    "lint:fix": "oxfmt --write && oxlint",
    "make-admin": "tsx scripts/make-admin.ts",
    "ccd:fixtures": "tsx scripts/ccd-fixtures.ts",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@hono/node-server": "^2.0.2",
    "@huggingface/transformers": "^4.2.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@xenova/transformers": "2.17.2",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.10.0",
    "busboy": "^1.6.0",
    "canvas": "^3.2.3",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.2",
    "gliner": "^0.0.19",
    "hono": "^4.12.18",
    "jszip": "^3.10.1",
    "mime-types": "^3.0.2",
    "music-metadata": "^11.12.3",
    "node-html-parser": "^7.1.0",
    "node-id3": "^0.2.9",
    "node-unrar-js": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-flight-router": "^0.6.0",
    "react-server-dom-webpack": "^19.2.6",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/mime-types": "^3.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260514.1",
    "@vitejs/plugin-react": "6.0.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "knip": "^6.13.1",
    "lint-staged": "^17.0.4",
    "oxfmt": "0.49.0",
    "oxlint": "1.64.0",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vite": "8.0.13",
    "vitest": "^4.1.6",
    "wrangler": "^4.91.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --write",
      "oxlint"
    ],
    "*.{json,css,md}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "canvas",
      "core-js",
      "es5-ext",
      "esbuild",
      "onnxruntime-node",
      "puppeteer",
      "sharp"
    ],
    "overrides": {
      "pdfjs-dist": "^5.4.530",
      "onnxruntime-node": "1.24.3",
      "sharp": "^0.34.5"
    }
  }
}
