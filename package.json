{
  "name": "compendus",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "pnpm run build && node --import tsx server.ts",
    "dev": "vite",
    "build": "tsx scripts/build-worker.ts && react-flight-router build && tsx scripts/copy-migrations.ts",
    "build:worker": "tsx scripts/build-worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "oxfmt --check && oxlint",
    "lint:fix": "oxfmt --write && oxlint",
    "make-admin": "tsx scripts/make-admin.ts",
    "ccd:fixtures": "tsx scripts/ccd-fixtures.ts",
    "showcase:seed": "tsx scripts/showcase/seed.ts",
    "showcase:capture:web": "tsx scripts/showcase/capture-web.ts",
    "showcase:capture:ios": "tsx scripts/showcase/capture-ios.ts",
    "showcase:capture": "pnpm showcase:capture:web && pnpm showcase:capture:ios",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@hono/node-server": "^2.0.4",
    "@huggingface/transformers": "^4.2.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@xenova/transformers": "2.17.2",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.10.0",
    "busboy": "^1.6.0",
    "canvas": "^3.2.3",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.2",
    "gliner": "^0.0.19",
    "hono": "^4.12.25",
    "jszip": "^3.10.1",
    "mime-types": "^3.0.2",
    "music-metadata": "^11.13.0",
    "node-html-parser": "^7.1.0",
    "node-id3": "^0.2.9",
    "node-unrar-js": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-flight-router": "^0.10.0",
    "react-server-dom-webpack": "^19.2.7",
    "sharp": "^0.35.0",
    "shiki": "^4.2.0",
    "usearch": "^2.25.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/mime-types": "^3.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260610.1",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "lint-staged": "^17.0.7",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.99.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --write",
      "oxlint"
    ],
    "*.{json,css,md}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@11.5.2"
}
